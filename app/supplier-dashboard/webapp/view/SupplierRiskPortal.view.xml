<mvc:View controllerName="com.supplierrisk.supplierdashboard.controller.SupplierRiskPortal"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:microchart="sap.suite.ui.microchart"
    displayBlock="true">

    <Page
        id="supplierDashboardPage"
        title="Supplier Exception Dashboard"
        class="sapUiResponsiveContentPadding">

        <content>
            <VBox width="100%" class="sapUiSmallMargin">

                <!-- Dashboard heading -->
                <Title
                    text="Supplier Risk Overview"
                    level="H2"
                    class="sapUiSmallMarginBottom"/>

                <Text
                    text="Monitor supplier exposure, delivery reliability, and purchase order exceptions."
                    wrapping="true"
                    class="sapUiSmallMarginBottom"/>

                <!-- SIDE-BY-SIDE CONTAINER -->
                <HBox
                    width="100%"
                    alignItems="Start"
                    justifyContent="SpaceBetween"
                    class="sapUiSmallMarginBottom">

                    <!-- LEFT: CHART WRAPPER VBOX (68% width) -->
                    <VBox width="68%">
                        <Panel
                            id="riskSpendPanel"
                            headerText="Risk Spend by Supplier"
                            expandable="false"
                            width="100%">
                            <content>
                                <viz:VizFrame
                                    id="riskSpendChart"
                                    width="100%"
                                    height="400px"
                                    vizType="column"
                                    uiConfig="{applicationSet:'fiori'}">

                                    <viz:dataset>
                                        <viz.data:FlattenedDataset
                                            data="{dashboard>/riskSpend}">

                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition
                                                    name="Supplier"
                                                    value="{dashboard>supplierName}"/>

                                                <viz.data:DimensionDefinition
                                                    name="Risk Status"
                                                    value="{dashboard>riskStatus}"/>
                                            </viz.data:dimensions>

                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition
                                                    name="Risk Spend"
                                                    value="{dashboard>orderValue}"/>
                                            </viz.data:measures>

                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>

                                    <viz:feeds>
                                        <viz.feeds:FeedItem
                                            uid="valueAxis"
                                            type="Measure"
                                            values="Risk Spend"/>

                                        <viz.feeds:FeedItem
                                            uid="categoryAxis"
                                            type="Dimension"
                                            values="Supplier"/>

                                        <viz.feeds:FeedItem
                                            uid="color"
                                            type="Dimension"
                                            values="Risk Status"/>
                                    </viz:feeds>

                                </viz:VizFrame>
                            </content>
                        </Panel>
                    </VBox>

                    <!-- RIGHT: MICRO INDICATORS (30% width) -->
                    <VBox width="30%">
                        <Title
                            text="Performance Metrics"
                            level="H5"
                            class="sapUiSmallMarginBottom"/>

                        <GenericTile
                            header="Delivery Reliability"
                            frameType="OneByHalf"
                            class="sapUiSmallMarginBottom"
                            width="100%">
                            <TileContent>
                                <!-- <NumericContent
                                    value="{dashboard>/deliveryReliability}"
                                    scale="%"
                                    valueColor="{dashboard>/deliveryColor}"
                                    indicator="None"/> -->
                                    <microchart:RadialMicroChart
                                    percentage="{dashboard>/deliveryReliability}"
                                    valueColor="{dashboard>/deliveryColor}"/>
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            header="Compliance"
                            frameType="OneByHalf"
                            width="100%">
                            <TileContent>
                                <!-- <NumericContent
                                    value="{dashboard>/compliance}"
                                    scale="%"
                                    valueColor="{dashboard>/complianceColor}"
                                    indicator="None"/> -->
                                    <microchart:RadialMicroChart
                                    percentage="{dashboard>/compliance}"
                                    valueColor="{dashboard>/complianceColor}"/>
                            </TileContent>
                        </GenericTile>
                    </VBox>

                </HBox>

                <!-- PURCHASE ORDER TABLE -->
                <Panel
                    headerText="Operational Purchase Orders"
                    expandable="false">

                    <content>
                        <Table
                            id="purchaseOrderTable"
                            items="{dashboard>/purchaseOrders}"
                            growing="true"
                            growingThreshold="10"
                            noDataText="No purchase orders found">

                            <columns>
                                <Column><Text text="PO Number"/></Column>
                                <Column><Text text="Supplier"/></Column>
                                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                    <Text text="Order Value"/>
                                </Column>
                                <Column><Text text="Status"/></Column>
                                <Column><Text text="Risk Level"/></Column>
                            </columns>

                            <items>
                                <ColumnListItem
                                    type="Navigation"
                                    press=".onOpenSupplier">
                                    <cells>
                                        <Text text="{dashboard>poId}"/>
                                        <Text text="{dashboard>supplierName}"/>
                                        <ObjectNumber
                                            number="{dashboard>orderValue}"
                                            unit="USD"/>
                                        <ObjectStatus
                                            text="{dashboard>lifecycleStatus}"
                                            state="{dashboard>statusState}"/>
                                        <ObjectStatus
                                            text="{dashboard>riskStatus}"
                                            state="{dashboard>riskState}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                    </content>
                </Panel>

            </VBox>
        </content>

        <!-- Floating chat button -->
        <dependents>
            <Dialog
                id="globalChatDialog"
                title="Supplier Risk AI Assistant"
                contentWidth="400px"
                contentHeight="500px"
                stretchOnPhone="true">

                <content>
                    <VBox class="sapUiSmallMargin" height="100%">
                        <ScrollContainer
                            height="350px"
                            vertical="true"
                            horizontal="false">
                            <List
                                items="{chat>/messages}"
                                showSeparators="Inner">
                                <CustomListItem>
                                    <VBox class="sapUiSmallMargin">
                                        <Title text="{chat>sender}" level="H6"/>
                                        <Text text="{chat>messageText}" wrapping="true"/>
                                    </VBox>
                                </CustomListItem>
                            </List>
                        </ScrollContainer>

                        <Toolbar>
                            <Input
                                id="chatInput"
                                placeholder="Ask about supplier risk..."
                                submit=".onSendChat"
                                width="100%"/>
                            <Button
                                icon="sap-icon://paper-plane"
                                type="Emphasized"
                                press=".onSendChat"
                                tooltip="Send message"/>
                        </Toolbar>
                    </VBox>
                </content>

                <endButton>
                    <Button text="Close" press=".onCloseChat"/>
                </endButton>

            </Dialog>
        </dependents>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    text="Ask AI"
                    icon="sap-icon://discussion-2"
                    type="Emphasized"
                    tooltip="Open global AI assistant"
                    press=".onOpenChat"/>
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>