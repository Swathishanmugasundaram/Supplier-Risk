<mvc:View controllerName="com.supplierrisk.supplierdashboard.controller.SupplierRiskPortal"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    displayBlock="true">
    <!-- <Page id="page" title="{i18n>title}">
   
    </Page> -->
    <Page
        id="supplierDashboardPage"
        title="Supplier Exception Dashboard"
        class="sapUiResponsiveContentPadding">

        <content>

            <VBox width="100%" class="sapUiSmallMargin">

                <!-- Dashboard heading -->
                <Title
                    text="Supplier Risk Overview"
                    level="H2"
                    class="sapUiSmallMarginBottom"/>

                <Text
                    text="Monitor supplier exposure, delivery reliability, and purchase order exceptions."
                    wrapping="true"
                    class="sapUiSmallMarginBottom"/>

                <!-- MICRO INDICATORS -->
                <HBox
                    wrap="Wrap"
                    justifyContent="SpaceBetween"
                    class="sapUiSmallMarginBottom">

                    <GenericTile
                        header="Delivery Reliability"
                        subheader="Demonstration value"
                        frameType="OneByHalf"
                        class="sapUiTinyMargin">

                        <TileContent>
                            <NumericContent
                                value="{dashboard>/deliveryReliability}"
                                scale="%"
                                valueColor="{dashboard>/deliveryColor}"
                                indicator="None"/>
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        header="Compliance"
                        subheader="Demonstration value"
                        frameType="OneByHalf"
                        class="sapUiTinyMargin">

                        <TileContent>
                            <NumericContent
                                value="{dashboard>/compliance}"
                                scale="%"
                                valueColor="{dashboard>/complianceColor}"
                                indicator="None"/>
                        </TileContent>
                    </GenericTile>

                </HBox>

                <!-- RISK SPEND CHART -->
                <Panel
                    headerText="Risk Spend by Supplier"
                    expandable="false"
                    class="sapUiSmallMarginBottom">

                    <content>

                        <viz:VizFrame
                            id="riskSpendChart"
                            width="100%"
                            height="350px"
                            vizType="stacked_bar"
                            uiConfig="{applicationSet:'fiori'}"
                            vizProperties="{
                                title: {
                                    visible: true,
                                    text: 'Purchase Order Value by Supplier'
                                },
                                legend: {
                                    visible: true,
                                    position: 'bottom'
                                },
                                plotArea: {
                                    dataLabel: {
                                        visible: true
                                    }
                                }
                            }">

                            <viz:dataset>
                                <viz.data:FlattenedDataset
                                    data="{dashboard>/riskSpend}">

                                    <viz.data:dimensions>
                                        <viz.data:DimensionDefinition
                                            name="Supplier"
                                            value="{dashboard>supplierName}"/>
                                    </viz.data:dimensions>

                                    <viz.data:measures>
                                        <viz.data:MeasureDefinition
                                            name="Purchase Order Value"
                                            value="{dashboard>orderValue}"/>
                                    </viz.data:measures>

                                </viz.data:FlattenedDataset>
                            </viz:dataset>

                            <viz:feeds>
                                <viz.feeds:FeedItem
                                    uid="valueAxis"
                                    type="Measure"
                                    values="Purchase Order Value"/>

                                <viz.feeds:FeedItem
                                    uid="categoryAxis"
                                    type="Dimension"
                                    values="Supplier"/>
                            </viz:feeds>

                        </viz:VizFrame>

                    </content>
                </Panel>

                <!-- PURCHASE ORDER TABLE -->
                <Panel
                    headerText="Operational Purchase Orders"
                    expandable="false">

                    <content>

                        <Table
                            id="purchaseOrderTable"
                            items="{dashboard>/purchaseOrders}"
                            growing="true"
                            growingThreshold="10"
                            noDataText="No purchase orders found">

                            <columns>

                                <Column>
                                    <Text text="PO Number"/>
                                </Column>

                                <Column>
                                    <Text text="Supplier"/>
                                </Column>

                                <Column
                                    hAlign="End"
                                    minScreenWidth="Tablet"
                                    demandPopin="true">
                                    <Text text="Order Value"/>
                                </Column>

                                <Column>
                                    <Text text="Status"/>
                                </Column>

                                <Column>
                                    <Text text="Risk Level"/>
                                </Column>

                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>

                                        <Text text="{dashboard>poNumber}"/>

                                        <Text text="{dashboard>supplierName}"/>

                                        <ObjectNumber
                                            number="{dashboard>orderValue}"
                                            unit="USD"/>

                                        <ObjectStatus
                                            text="{dashboard>lifecycleStatus}"
                                            state="{dashboard>statusState}"/>

                                        <ObjectStatus
                                            text="{dashboard>riskStatus}"
                                            state="{dashboard>riskState}"/>

                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>

                    </content>
                </Panel>

                <MessageStrip
                    text="Delivery Reliability and Compliance are demonstration values until actual metrics are provided by the backend."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginTop"/>

            </VBox>

        </content>

        <!-- Floating chat button -->
        <dependents>
            <Dialog
                id="globalChatDialog"
                title="Supplier Risk AI Assistant"
                contentWidth="400px"
                contentHeight="500px"
                stretchOnPhone="true">

                <content>
                    <VBox class="sapUiSmallMargin" height="100%">

                        <ScrollContainer
                            height="350px"
                            vertical="true"
                            horizontal="false">

                            <List
                                items="{chat>/messages}"
                                showSeparators="Inner">

                                <CustomListItem>
                                    <VBox class="sapUiSmallMargin">

                                        <Text
                                            text="{chat>sender}"
                                             level="H6"/>

                                        <Text
                                            text="{chat>messageText}"
                                            wrapping="true"/>

                                    </VBox>
                                </CustomListItem>

                            </List>

                        </ScrollContainer>

                        <Toolbar>
                            <Input
                                id="chatInput"
                                placeholder="Ask about supplier risk..."
                                submit=".onSendChat"
                                width="100%"/>

                            <Button
                                icon="sap-icon://paper-plane"
                                type="Emphasized"
                                press=".onSendChat"
                                tooltip="Send message"/>
                        </Toolbar>

                    </VBox>
                </content>

                <endButton>
                    <Button
                        text="Close"
                        press=".onCloseChat"/>
                </endButton>

            </Dialog>
        </dependents>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>

                <Button
                    text="Ask AI"
                    icon="sap-icon://discussion-2"
                    type="Emphasized"
                    tooltip="Open global AI assistant"
                    press=".onOpenChat"/>
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>